# Required: password for /#/admin (10+ characters)
ADMIN_PASSWORD=change-me-to-a-long-password
PORT=3000
# Set to production when served over HTTPS (enables Secure cookies + HSTS)
NODE_ENV=development
# Set to 1 when behind a reverse proxy / hosting platform (uses X-Forwarded-For for rate limits)
TRUST_PROXY=0
# Optional: where uploads and the database live (mount a persistent disk here in production)
# DATA_DIR=./data
# Optional: email notifications for new inquiries via Resend (https://resend.com)
# RESEND_API_KEY=
# MAIL_FROM=Caventra <hello@yourdomain.com>
# NOTIFY_TO=caventraofficial@gmail.com

# ============================================================
# Firebase Development Project Configuration (LOCAL DEV ONLY)
# Dedicated Firebase Project: caventra-dev
# ============================================================
FIREBASE_API_KEY=your-dev-api-key
FIREBASE_AUTH_DOMAIN=caventra-dev.firebaseapp.com
FIREBASE_PROJECT_ID=caventra-dev
FIREBASE_STORAGE_BUCKET=caventra-dev.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id

# Optional: Firebase Local Emulator Suite
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
